rules_version = '2';

// Regras de segurança da VanCode (cole em: Firestore Database → Regras → Publicar)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Cartão público do ranking: só apelido e números.
    function validPlayer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'xp', 'lessons', 'arena', 'streak', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.xp is int && d.xp >= 0 && d.xp <= 1000000
        && d.lessons is int && d.lessons >= 0 && d.lessons <= 200
        && d.arena is int && d.arena >= 0 && d.arena <= 200
        && d.streak is int && d.streak >= 0 && d.streak <= 5000
        && d.updatedAt == request.time;
    }

    // Progresso completo do aluno: só o próprio aluno lê e escreve.
    match /progress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Ranking: todo mundo pode ver; cada aluno só mexe no próprio cartão.
    // O limite de XP por gravação dificulta "trapaças" pelo console do navegador.
    match /players/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validPlayer() && request.resource.data.xp <= 2000;
      allow update: if isOwner(uid) && validPlayer() && request.resource.data.xp <= resource.data.xp + 600;
      allow delete: if isOwner(uid);
    }
  }
}
